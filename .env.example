# AI Bridge — environment configuration template.
# Copy to .env (dev) or .env.production (prod) and fill in every value.
# NEVER commit a filled-in copy: all secrets below must be generated per
# deployment (see deployment/linux/deploy-production.sh, which generates
# .env.production mode 0600 with `openssl rand`). No secret has a default
# in this file or in the compose files — compose fails fast if a required
# secret is unset (R-P0-15).

# --- Control plane authentication (REQUIRED) -------------------------------
# Long random token for the admin API. Generate: openssl rand -hex 32
AI_BRIDGE_ADMIN_TOKEN=
# Flask/FastAPI session secret. Generate: openssl rand -hex 32
SECRET_KEY=

# --- Database (REQUIRED in production) ------------------------------------
# Full URL used by the control plane, e.g.
# postgresql+psycopg://ai_bridge:<password>@postgres:5432/ai_bridge
DATABASE_URL=
# Password for the postgres service (also embedded in DATABASE_URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ai_bridge
POSTGRES_USER=ai_bridge

# --- Cache / shared state ---------------------------------------------------
# Redis URL for multi-worker state (rate limits, pub/sub). Compose prod
# sets redis://redis:6379/0; Render has no Redis (single instance).
REDIS_URL=
REDIS_PASSWORD=

# --- Public URLs ------------------------------------------------------------
AI_BRIDGE_PUBLIC_URL=
AI_BRIDGE_PUBLIC_BASE_URL=
AI_BRIDGE_DOMAIN=
AI_BRIDGE_CONTROL_PORT=8000
AI_BRIDGE_CONTROL_URL=

# --- Policy -----------------------------------------------------------------
# Tier 3 (shell/desktop control). Default is 0 (OFF) in production
# (R-P0-14). Set to 1 only as an explicit opt-in per deployment.
AI_BRIDGE_ALLOW_TIER3=0
AI_BRIDGE_DEVICE_TOKEN_TTL_DAYS=7

# --- MCP / OAuth gateway ----------------------------------------------------
AI_BRIDGE_MCP_HOST=
AI_BRIDGE_OAUTH_HOST=
AI_BRIDGE_OAUTH_ISSUER=
AI_BRIDGE_OAUTH_DB=
AI_BRIDGE_EMBED_MCP=
AI_BRIDGE_MCP_ALLOWED_HOSTS=
AI_BRIDGE_MCP_ALLOWED_ORIGINS=
AI_BRIDGE_CORS_ORIGINS=

# --- WebRTC / TURN (REQUIRED in production) ---------------------------------
# Static auth secret for coturn. Generate: openssl rand -hex 32
AI_BRIDGE_TURN_SECRET=
AI_BRIDGE_TURN_HOST=
AI_BRIDGE_TURN_URL=
AI_BRIDGE_TURN_USERNAME=
AI_BRIDGE_TURN_CREDENTIAL=

# --- OIDC -------------------------------------------------------------------
AI_BRIDGE_OIDC_ISSUER=
AI_BRIDGE_OIDC_CLIENT_ID=
AI_BRIDGE_OIDC_CLIENT_SECRET=
AI_BRIDGE_OIDC_REDIRECT_URI=
AI_BRIDGE_OIDC_DASHBOARD_URL=

# --- Agent / device ---------------------------------------------------------
AI_BRIDGE_DEVICE_TOKEN=
AI_BRIDGE_WORKSPACE=
AI_BRIDGE_DATA_DIR=
AI_BRIDGE_DESKTOP_ENABLED=
AI_BRIDGE_ALLOWED_APPS=
AI_BRIDGE_ALLOWED_SERVICES=

# --- Microsoft 365 connector ------------------------------------------------
AI_BRIDGE_M365_CLIENT_ID=
AI_BRIDGE_M365_CLIENT_SECRET=
AI_BRIDGE_M365_REDIRECT_URI=
AI_BRIDGE_M365_TENANT=
AI_BRIDGE_M365_TOKEN_KEY=
AI_BRIDGE_M365_ALLOW_WRITE=

# --- Alert webhooks (optional) ----------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
